  `id` bigint(20) NOT NULL,
  `j1` json NULL
) ENGINE=OLAP
DUPLICATE KEY(`id`)
DISTRIBUTED BY HASH(`id`) BUCKETS 1
PROPERTIES (
"replication_num" = "1",
"flat_json.enable" = "true",
"flat_json.column_paths.j1" = "k1"
);
-- result:
-- !result
ALTER TABLE tcp_alter SET ("flat_json.column_paths.j1" = "k1,k2,k3");
-- result:
-- !result
INSERT INTO tcp_alter VALUES
(1, parse_json('{"k1": "v1", "k2": "v2", "k3": 1.5}')),
(2, parse_json('{"k1": "v3", "k2": "v4", "k3": 2.5}'));
-- result:
-- !result
SELECT id, get_json_string(j1, '$.k1'), get_json_string(j1, '$.k2'),
       get_json_double(j1, '$.k3')
  FROM tcp_alter ORDER BY id;
-- result:
1	v1	v2	1.5
2	v3	v4	2.5
